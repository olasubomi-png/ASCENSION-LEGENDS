# ─────────────────────────────────────────────
# Ascension Legends — Environment Configuration
# Copy to .env and fill in all values.
# ─────────────────────────────────────────────

# Node environment
NODE_ENV=development

# ─── Discord ──────────────────────────────────
DISCORD_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_dev_guild_id_here  # dev-only: omit for global commands

# ─── MongoDB ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/ascension_legends

# ─── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ─── BullMQ ───────────────────────────────────
# Uses the same Redis connection above.
# Override prefix if you share a Redis instance.
BULLMQ_PREFIX=ascension

# ─── Application ──────────────────────────────
LOG_LEVEL=debug          # error | warn | info | http | debug
PORT=3001                # Health-check HTTP port

# ─── Admin API ────────────────────────────────
ADMIN_API_URL=http://localhost:3000
ADMIN_API_KEY=

# ─── Feature Flags ────────────────────────────
ENABLE_SHARDING=false
